<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Image2StudioTheme" parent="Maui.SplashTheme">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/image2PageBackground</item>
        <item name="android:navigationBarColor">@color/image2PageBackground</item>
        <item name="android:windowBackground">@color/image2PageBackground</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
